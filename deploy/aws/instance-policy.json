{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRiskRunnerConfig",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/risk-runner",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/risk-runner/*"
      ]
    }
  ]
}
