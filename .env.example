# Copy to .env and fill in.
RISK_RUNNER_INGEST_TOKEN=change-me-long-random-string
RISK_RUNNER_API_TOKEN=
# RISK_RUNNER_DATABASE_URL=sqlite:///./risk_runner.db
RISK_RUNNER_NVD_API_KEY=
RISK_RUNNER_ENRICHMENT_INTERVAL_HOURS=12

# AI analysis with Claude
RISK_RUNNER_AI_ENABLED=false
RISK_RUNNER_AI_MODEL=claude-opus-5-5
RISK_RUNNER_AI_EFFORT=medium
ANTHROPIC_API_KEY=

# Only for docker-compose.aws.yml (the database is Amazon RDS or another managed Postgres)
DOMAIN=risk-runner.example.com
# RISK_RUNNER_DATABASE_URL=postgresql+psycopg://risk:PASSWORD@your-db-host:5432/risk_runner?sslmode=require
